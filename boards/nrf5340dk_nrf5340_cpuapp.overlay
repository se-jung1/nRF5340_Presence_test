/*
 * nRF5340 DK <-> IWRL6432BOOST (uart1) + Sensirion SEN5x (i2c2).
 *
 *   SEN5x pin      nRF5340 DK
 *   1 VDD      ->  5V   (P20 power header. NOT 3V3 - the fan and laser want
 *                        5 V +-10 %, and the DK's 5V comes straight off USB)
 *   2 GND      --  GND
 *   3 SDA      <-> P1.02  (Arduino "SDA")
 *   4 SCL      <-  P1.03  (Arduino "SCL")
 *   5 SEL      --  GND    (selects I2C, and it must already be low when the
 *                          sensor powers up - wire it, do not strap it later)
 *   6 NC       --  leave it
 *
 * Logic is 3.3 V tolerant, so no level shifter even though VDD is 5 V. The
 * datasheet asks for external 10k pull-ups on SDA/SCL; bias-pull-up below uses
 * the nRF's own ~13k, which is enough on a short bench lead and marginal on a
 * long one. Fit the 10k for anything that leaves the desk.
 *
 * Keep the shield of the sensor floating (datasheet 4): its metal can is tied
 * to pin 2 internally, and giving that a second path to ground can push current
 * through the case.
 *
 * Three wires plus ground. Two are not enough: the demo cannot be reconfigured
 * without a reset, so the nRF5340 has to drive NRST itself. Both sides are
 * 3.3 V logic, so no level shifter.
 *
 * All four come off the EVM's LP/BP connector (J8/J9) - no soldering. SWRU596
 * Figure 3-5 shows UART, RESET, SPI, I2C and SOP0/SOP1 routed there.
 *
 * Arduino labels are from the DK's own gpio-map (nrf5340dk_common.dtsi), and
 * they do not track the port pin numbers: D2 is P1.04, D3 is P1.05, D4 is
 * P1.06. Check that map before wiring by the silk screen - our TX landing on
 * the radar's TX gives a dead link that looks exactly like a missing ground.
 *
 *   nRF5340 DK          IWRL6432BOOST
 *   P1.04 (D2, TX)  ->  J8 pin 7   (DCA_LP_RS232_RX, radar input)
 *   P1.05 (D3, RX)  <-  J8 pin 5   (DCA_LP_RS232_TX, radar output)
 *   P1.06 (D4)      ->  J9 pin 10  (RADAR_NRST_2, open drain, active low)
 *   GND             --  J8 pin 4   (or J9 pin 2)
 *
 * J8 pin 4 is the ONLY ground on that header. Pin 2 is MCU_5V and pin 1 is
 * MCU_3V3 - both are LaunchPad-side power inputs, and both feed through DNP
 * resistors (R87, R132), so they sit floating and read as nothing. Grounding
 * there costs no damage and gives no ground: the two boards end up with no
 * shared reference and the link is dead with rx=0, which looks identical to
 * a wrong data pin. Schematic sheet 15 (SWRR180), verified pin by pin.
 *
 * Free pins were picked around what the DK already uses: LEDs P0.28-31,
 * buttons P0.08/09/23/24, i2c1 P1.02/03, spi4 P1.13-15. P1.00/P1.01 (D0/D1)
 * were the original choice and work equally well - moved off them only to rule
 * the header out during bring-up.
 *
 * NOTE: set S1.4 = ON on the EVM. It is a DIP switch, not a jumper. Per
 * SWRU596 Figure 4-1, S1.4 OFF sends the UART to XDS_RS232 (the on-board
 * XDS110 USB bridge) and S1.4 ON sends it to DCA_LP_RS232, which is the net
 * that reaches J8/J9. Left OFF, the XDS110 drives the radar's RX line and
 * fights this board's TX. J8/J9 pin numbers are not in SWRU596 - buzz them
 * out or read the EVM schematic before wiring.
 */
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	/*
	 * NRST lives under zephyr,user rather than a node of its own: no driver
	 * owns this pin, radar.c just takes the gpio spec off it, and a bare
	 * node with no compatible has no binding, so its gpios cells never get
	 * generated. Active low because NRST is; the pin is configured open
	 * drain in code so the EVM's own reset circuit is never fought.
	 */
	zephyr,user {
		radar-nrst-gpios = <&gpio1 6 GPIO_ACTIVE_LOW>;   /* D4 */
	};
};

&pinctrl {
	uart1_radar: uart1_radar {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 4)>;   /* D2 */
		};
		group2 {
			psels = <NRF_PSEL(UART_RX, 1, 5)>;   /* D3 */
			/*
			 * Idle high while the radar is in reset. Note R95/R96
			 * on the EVM already pull both RS232 lines to 3V3, but
			 * at 100k - too weak to hold the line against this
			 * pin's own pull-down, so the bias here has to be the
			 * pull-up and not merely absent.
			 *
			 * Flip this to bias-pull-down when hunting for the
			 * right hole on J8: radar.c prints rxpin= on a failed
			 * CLI line, and against a pull-down only an actively
			 * driven pin reads high. On J8 that is exactly two
			 * pins - 5 (the radar's TX) and 14 (PGOOD) - which is
			 * enough to fix both the column and the pin 1 end
			 * without a multimeter. With the pull-up in place
			 * every hole reads high and the readout is useless.
			 */
			bias-pull-up;
		};
	};

	uart1_radar_sleep: uart1_radar_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 4)>,
				<NRF_PSEL(UART_RX, 1, 5)>;
			low-power-enable;
		};
	};

	/*
	 * Same two physical pins the DK silk-screens as SDA/SCL - only the
	 * peripheral behind them changes, since nRF pins are fully muxable.
	 */
	i2c2_sen5x: i2c2_sen5x {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 2)>,
				<NRF_PSEL(TWIM_SCL, 1, 3)>;
			bias-pull-up;
		};
	};

	i2c2_sen5x_sleep: i2c2_sen5x_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 2)>,
				<NRF_PSEL(TWIM_SCL, 1, 3)>;
			low-power-enable;
		};
	};
};

/*
 * 115200 and no flow control. The demo's cfg can switch itself to 1250000, but
 * this build does not send that line: Zephyr's nrfx uart driver has no table
 * entry for 1250000, and with the range profile TLV turned off the stream is a
 * few hundred bytes per frame at 4 fps - about 3% of what 115200 carries.
 */
/*
 * On the nRF5340, uart1/spi1/i2c1 are three faces of one peripheral instance
 * (SERIAL1 at 0x40009000). The DK board files leave i2c1 enabled for the
 * Arduino header, so with uart1 also on it the two nodes claim the same
 * hardware. That used to be harmless here because CONFIG_I2C was off; the
 * SEN5x turned it on, which is exactly the moment the two start fighting. The
 * sensor therefore hangs off i2c2 (SERIAL2 at 0x4000B000, otherwise unused on
 * this board) driven out to the same two header pins.
 */
&i2c1 {
	status = "disabled";
};

&i2c2 {
	status = "okay";
	/* Standard mode is all the SEN5x supports, and it does not clock
	 * stretch (datasheet 6). */
	clock-frequency = <100000>;
	pinctrl-0 = <&i2c2_sen5x>;
	pinctrl-1 = <&i2c2_sen5x_sleep>;
	pinctrl-names = "default", "sleep";

	/* No compatible: there is no in-tree SEN5x driver and src/sen5x.c
	 * speaks the three commands it needs directly. The node exists so the
	 * address and the bus come from devicetree rather than a #define. */
	sen5x: sen5x@69 {
		reg = <0x69>;
	};
};

&uart1 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart1_radar>;
	pinctrl-1 = <&uart1_radar_sleep>;
	pinctrl-names = "default", "sleep";
	/delete-property/ hw-flow-control;
};

/*
 * 24 h of records is 2880 * (24 B struct + 8 B NVS overhead) = ~90 KB at the
 * 30 s test period, so the board default 32 KB storage_partition would not even
 * hold the data, let alone leave room for garbage collection. Take the space
 * from slot1_partition, the MCUboot secondary slot, which is dead weight here -
 * this build has no DFU.
 *
 * 90 KB of 160 KB is the tightest this gets: at the intended 60 s period it is
 * 45 KB. NVS needs a spare sector to garbage-collect into and gets 17 of them
 * here, so even the test period has margin - but do not shorten the period
 * further without redoing this sum.
 *
 *   slot1   0x84000 .. 0xD8000  (336K, was 464K)
 *   storage 0xD8000 .. 0x100000 (160K, was 32K)
 */
&slot1_partition {
	reg = <0x00084000 0x00054000>;
};

&storage_partition {
	reg = <0x000d8000 0x00028000>;
};
