/*
 * nRF5340 DK <-> IWRL6432BOOST.
 *
 * Three wires plus ground. Two are not enough: the demo cannot be reconfigured
 * without a reset, so the nRF5340 has to drive NRST itself. Both sides are
 * 3.3 V logic, so no level shifter.
 *
 * All four come off the EVM's LP/BP connector (J8/J9) - no soldering. SWRU596
 * Figure 3-5 shows UART, RESET, SPI, I2C and SOP0/SOP1 routed there.
 *
 *   nRF5340 DK          IWRL6432BOOST J8/J9
 *   P1.00 (D1, TX)  ->  UART RX
 *   P1.01 (D0, RX)  <-  UART TX
 *   P1.05 (D3)      ->  RESET  (NRST, open drain, active low)
 *   GND             --  GND
 *
 * Free pins were picked around what the DK already uses: LEDs P0.28-31,
 * buttons P0.08/09/23/24, i2c1 P1.02/03, spi4 P1.13-15.
 *
 * NOTE: set S1.4 = ON on the EVM. It is a DIP switch, not a jumper. Per
 * SWRU596 Figure 4-1, S1.4 OFF sends the UART to XDS_RS232 (the on-board
 * XDS110 USB bridge) and S1.4 ON sends it to DCA_LP_RS232, which is the net
 * that reaches J8/J9. Left OFF, the XDS110 drives the radar's RX line and
 * fights this board's TX. J8/J9 pin numbers are not in SWRU596 - buzz them
 * out or read the EVM schematic before wiring.
 */
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	/*
	 * NRST lives under zephyr,user rather than a node of its own: no driver
	 * owns this pin, radar.c just takes the gpio spec off it, and a bare
	 * node with no compatible has no binding, so its gpios cells never get
	 * generated. Active low because NRST is; the pin is configured open
	 * drain in code so the EVM's own reset circuit is never fought.
	 */
	zephyr,user {
		radar-nrst-gpios = <&gpio1 5 GPIO_ACTIVE_LOW>;
	};
};

&pinctrl {
	uart1_radar: uart1_radar {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 0)>;
		};
		group2 {
			psels = <NRF_PSEL(UART_RX, 1, 1)>;
			bias-pull-up;   /* idle high while the radar is in reset */
		};
	};

	uart1_radar_sleep: uart1_radar_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 0)>,
				<NRF_PSEL(UART_RX, 1, 1)>;
			low-power-enable;
		};
	};
};

/*
 * 115200 and no flow control. The demo's cfg can switch itself to 1250000, but
 * this build does not send that line: Zephyr's nrfx uart driver has no table
 * entry for 1250000, and with the range profile TLV turned off the stream is a
 * few hundred bytes per frame at 4 fps - about 3% of what 115200 carries.
 */
&uart1 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart1_radar>;
	pinctrl-1 = <&uart1_radar_sleep>;
	pinctrl-names = "default", "sleep";
	/delete-property/ hw-flow-control;
};

/*
 * 24 h of records is 2880 * (16 B struct + 8 B NVS overhead) = ~69 KB, so the
 * board default 32 KB storage_partition would have no room left for garbage
 * collection. Take the space from slot1_partition, the MCUboot secondary slot,
 * which is dead weight here - this build has no DFU.
 *
 *   slot1   0x84000 .. 0xD8000  (336K, was 464K)
 *   storage 0xD8000 .. 0x100000 (160K, was 32K)
 */
&slot1_partition {
	reg = <0x00084000 0x00054000>;
};

&storage_partition {
	reg = <0x000d8000 0x00028000>;
};
